DATABASE_URL="postgresql://postgres:password@localhost:5432/resumia"

# JWT Secret (generate a secure one)
JWT_SECRET="your-jwt-secret-key-here-make-it-long-and-random"

# OpenAI API Key
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Google Cloud Talent Solution API
GOOGLE_CLOUD_PROJECT_ID="your-project-id"
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"
# GOOGLE_CLOUD_TENANT_ID="" (Add after running create-tenant.js)

# Job Search Settings

# PRIORITY #1: Web Crawler (Real jobs from Pakistani sites)
# Set to 'true' to use web crawler (Rozee.pk, JobsAlert.pk, Mustakbil.com)
# Returns 35+ real jobs per search from multiple sources
USE_WEBCRAWLER="true"

# PRIORITY #2: RapidAPI JSearch (FREE - 150 searches/month)
# Set to 'true' to use RapidAPI (10 jobs per search)
USE_RAPIDAPI="false"
RAPIDAPI_KEY="your-rapidapi-key-here"

# PRIORITY #3: Mock Data (Testing)
# Set to 'true' to use mock data instead of APIs (useful for testing)
USE_MOCK_JOBS="false"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NODE_ENV="development"
